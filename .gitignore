# ==========================================
# MediSlot Master .gitignore
# ==========================================

# 1. Environment & Secret Variables (Strict Exclusion across all nested folders)
**/.env
**/.env.*
**/.env.local
**/.env.*.local
!**/.env.example

# 2. Cryptographic Keys & Sensitive Credentials
**/*.pem
**/*.key
**/*.cert
**/*.crt
**/*.pfx
**/*.p12

# 3. Dependencies
node_modules/
**/node_modules/

# 4. Build Outputs & Compilations
dist/
**/dist/
build/
**/build/
.cache/
**/.cache/
*.tsbuildinfo

# 5. Python & AI Microservice Environments
__pycache__/
**/__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
ENV/
env/
*.egg-info/
.pytest_cache/

# 6. Patient Files, Uploads & Temporary Media
uploads/
**/uploads/
storage/
**/storage/
temp/
**/temp/
tmp/
**/tmp/
*.pdf
!docs/**/*.pdf

# 7. System & Runtime Logs
logs/
**/logs/
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# 8. OS & IDE Metadata
.DS_Store
Thumbs.db
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
