PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173
AI_SERVICE_URL=http://localhost:8000
AI_SERVICE_SECRET=medislot-internal-ai-secret-2026

# Supabase PostgreSQL Connection Strings
# Transaction Pooler (Port 6543 with ?pgbouncer=true)
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"

# Direct Session Connection (Port 5432 for migrations)
DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# Supabase Admin API Keys
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_ANON_KEY="your-supabase-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"

# Local Secret for JWT signing fallback
JWT_SECRET="your-32-character-secret-key-here"
